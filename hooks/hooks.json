{
  "$schema": "https://www.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/korean-writing-reminder.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
